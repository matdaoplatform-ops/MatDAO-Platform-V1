# =============================================================================
# Local development template — copy to .env.local and fill in your own values.
# Never commit real keys. All values below are placeholders.
# =============================================================================

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application origin (used in emails and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications (optional — without RESEND_API_KEY emails are skipped and logged)
RESEND_API_KEY=
MATDAO_NOTIFY_EMAIL=reviews@your-domain.example
MATDAO_FROM_EMAIL=MatDAO <onboarding@resend.dev>

# AI Engine / TRL Services backends
IP_ENGINE_URL=http://localhost:8000
TRL_SERVICES_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TRL_SERVICES_URL=http://localhost:8001

# Web3 (Sepolia testnet only)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
NEXT_PUBLIC_MATDAO_CHAIN_ID=11155111
NEXT_PUBLIC_MATDAO_IPNFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MATDAO_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MATDAO_SWAP_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: dedicated Sepolia RPC for the browser wagmi client (falls back to the public RPC)
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key
NEXT_PUBLIC_MATDAO_IPT_ADDRESS=0x0000000000000000000000000000000000000000

# Pinata (IPFS)
PINATA_JWT=your-pinata-jwt
PINATA_GATEWAY=your-gateway.mypinata.cloud

# Hardhat deployment (never use a funded mainnet key here)
PRIVATE_KEY=0xyour-testnet-deployer-private-key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key
ETHERSCAN_API_KEY=your-etherscan-api-key
